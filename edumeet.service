[Unit]
Description=edumeet is a audio / video meeting service running in the browser and powered by webRTC
After=network.target

[Service]
# modify the paths accordingly with your installation
ExecStart=/home/bxg/.nvm/versions/node/v18.20.4/bin/node /home/bxg/project/edumeet/edumeet/server/dist/server.js
WorkingDirectory=/home/bxg/project/edumeet/edumeet/server
Restart=always
RestartSec=1
User=bxg
Group=bxg
Environment=PATH=/usr/bin:/usr/local/bin
Environment=MEDIASOUP_WORKER_BIN=/home/bxg/project/edumeet/mediasoup/worker/out/Release/mediasoup-worker
Environment=NODE_ENV=production
Environment=DEBUG="edumeet-server* mediasoup* *ERROR*,*WARN*,*INFO*"
StandardOutput=journal
StandardError=journal
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
